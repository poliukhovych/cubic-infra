# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=schedule_db
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/schedule_db

# --- cubic-backend ---
# Required, the backend refuses to start with a placeholder: openssl rand -hex 32
JWT_SECRET_KEY=
SCHEDULER_URL=http://scheduler_api:8000
CORS_ALLOW_ORIGINS=http://localhost

# Admin login without Google OAuth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# --- Google OAuth (Google Cloud Console > Credentials > OAuth 2.0 Client ID) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- cubic-frontend (runtime config via envsubst) ---
APP_BASE_PATH=/
API_BASE_URL=/api
# Must match an Authorized redirect URI in Google Console exactly
GOOGLE_REDIRECT_URI=http://localhost/auth/callback
GOOGLE_USE_CODE_FLOW=1
# 1 = show quick "login as" buttons. Never enable in production.
DEV_AUTH=0

# --- unischedule-py ---
REDIS_URL=redis://redis:6379/0
