# Local Caddyfile: serves http://localhost without ACME/TLS.
:80 {
    route /api/* {
        reverse_proxy main_api:8000
    }

    # The solver serves routes under /v1/*, so strip the /scheduler prefix.
    handle_path /scheduler/* {
        reverse_proxy scheduler_api:8000
    }

    handle {
        reverse_proxy frontend:80
    }

    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
